# Copy to .env and fill in LLM_API_KEY.

# --- LLM (text + vision), any OpenAI-compatible endpoint ---
# Google Gemini (free tier available): https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
VISION_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# OpenAI instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# VISION_MODEL=gpt-4o-mini

# Fully local with Ollama (slow on a 4 GB GPU; pull the models first):
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b
# VISION_MODEL=qwen2.5vl:3b

# --- Embeddings (local, via the ollama container) ---
EMBED_PROVIDER=ollama
EMBED_MODEL=bge-m3

# --- RAG ---
CHUNK_STRATEGY=section
TOP_K=5

# --- Prompt versions used at run time ---
PROMPT_CV_AGENT=v2
PROMPT_JOB_AGENT=v3
PROMPT_MATCHING_AGENT=v2
PROMPT_AUDIT_AGENT=v3
PROMPT_VISION_READER=v1
