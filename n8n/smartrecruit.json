        "jsCode": "// Back to one item for the whole run\nconst items = $input.all();\nreturn [{ json: {\n  run_id: items[0].json.run_id,\n  audited: items.map(i => ({ candidate_id: i.json.candidate_id, retried: i.json.retried, issues_left: i.json.remaining_issues }))\n} }];"
